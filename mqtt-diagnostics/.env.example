# Copy this file to .env and fill in the broker URL and read-only credentials.
# Keep this diagnostic client ID unique; do not reuse the production backend ID.
MQTT_URL=mqtt://broker-host:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=sensor
# Must be outside every filter in MQTT_TOPIC; broker ACLs must allow pub/sub here.
MQTT_ROUNDTRIP_TOPIC=watchguardian/diagnostics/roundtrip
MQTT_CLIENT_ID=
MQTT_SUBSCRIPTION_QOS=1

# Local-only ports. Compose binds all three to 127.0.0.1.
DASHBOARD_HOST_PORT=4173
API_HOST_PORT=5003
POSTGRES_HOST_PORT=55432

# Local database credentials; these are not used by MongoDB.
POSTGRES_DB=mqtt_diagnostics
POSTGRES_USER=diagnostics
POSTGRES_PASSWORD=local-diagnostics-only

# Capture and device freshness policy.
MQTT_CAPTURE_MAX_BYTES=16384
CAPTURE_RETENTION_DAYS=14
DEVICE_RECENT_SECONDS=300
DEVICE_OFFLINE_SECONDS=900
