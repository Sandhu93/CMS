MQTT_ADDRESS=mqtt://broker-host:1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=sensor
MQTT_CAPTURE_ENABLED=true
MQTT_CAPTURE_MAX_BYTES=16384
MQTT_CAPTURE_FILE=logs/mqtt-ingress.ndjson
SOCKET_PORT=5002
DEVELOPMENT=true
MAX_BATTERY=12
JWT_SALT=replace-with-a-local-only-random-value
MONGODB_URI=mongodb://127.0.0.1:27017/cms_dashboard
